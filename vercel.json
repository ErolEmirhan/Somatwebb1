{
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon-32.png",
      "permanent": false
    },
    {
      "source": "/anasayfa",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/About",
      "destination": "/hakkimizda",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/hakkimizda",
      "permanent": true
    },
    {
      "source": "/IMG_0367.png",
      "destination": "/IMG_0367.webp",
      "permanent": true
    },
    {
      "source": "/IMG_0371.png",
      "destination": "/IMG_0371.webp",
      "permanent": true
    },
    {
      "source": "/IMG_3323.png",
      "destination": "/IMG_3323.webp",
      "permanent": true
    },
    {
      "source": "/IMG_3698.png",
      "destination": "/IMG_3698.webp",
      "permanent": true
    },
    {
      "source": "/IMG_8589.png",
      "destination": "/IMG_8589.webp",
      "permanent": true
    },
    {
      "source": "/IMG_8597.png",
      "destination": "/IMG_8597.webp",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/IMG_(.*).webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
